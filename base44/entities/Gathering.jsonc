{
  "name": "Gathering",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "cover_image": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Legacy stored date. No longer collected in the UI \u2014 a gathering's range is derived from its journey items. Kept for backwards compatibility with existing records."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Legacy stored date. No longer collected in the UI \u2014 a gathering's range is derived from its journey items. Kept for backwards compatibility with existing records."
    },
    "destinations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Legacy free-text destination strings. Kept for backwards compatibility; new gatherings use destination_places."
    },
    "destination_places": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "place_id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          }
        }
      },
      "description": "Structured Google Places destinations picked via autocomplete. Each entry carries place_id / name / address / lat / lng so the UI can render an external Open-in-Google-Maps link."
    },
    "privacy_mode": {
      "type": "string",
      "enum": [
        "open",
        "invite",
        "approval"
      ],
      "default": "invite"
    },
    "description": {
      "type": "string"
    },
    "whatsapp_url": {
      "type": "string"
    },
    "music_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "completed"
      ],
      "default": "planning",
      "description": "Deprecated: the status concept is dead. The column is kept so existing records don't break, but nothing in the UI reads or writes it \u2014 ordering/labels are derived from journey-item dates."
    },
    "owner_user_id": {
      "type": "string"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source_beta_trip_id": {
      "type": "string",
      "description": "Beta app trip ID this gathering was migrated from. Data-only; used for idempotency/dedup. No UI reads it."
    },
    "source_trip_type": {
      "type": "string",
      "description": "Original beta trip_type (e.g. trip/event). Data-only; no current equivalent field exists."
    },
    "timezone": {
      "type": [
        "string",
        "null"
      ],
      "description": "Beta gathering-level timezone. Data-only; nullable. No current equivalent field exists."
    },
    "location_buffer_days": {
      "type": "number",
      "description": "Beta location buffer days. Data-only; no current equivalent field exists."
    },
    "source_start_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Exact original beta start ISO timestamp. Data-only; preserved for fidelity alongside the date-only start_date."
    },
    "source_end_datetime": {
      "type": "string",
      "format": "date-time",
      "description": "Exact original beta end ISO timestamp. Data-only; preserved for fidelity alongside the date-only end_date."
    },
    "source_cover_photographer": {
      "type": "string",
      "description": "Beta cover attribution. Data-only; no current equivalent field exists."
    },
    "source_cover_photographer_url": {
      "type": "string",
      "description": "Beta cover photographer profile URL. Data-only."
    },
    "source_cover_pexels_url": {
      "type": "string",
      "description": "Beta cover Pexels photo page URL. Data-only."
    },
    "source_main_event_owner_item_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "Beta main-event owner item id. Data-only; nullable."
    },
    "source_main_event_was_created": {
      "type": "boolean",
      "description": "Beta main-event creation flag. Data-only."
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.email}}"
        },
        {
          "data.owner_user_id": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}