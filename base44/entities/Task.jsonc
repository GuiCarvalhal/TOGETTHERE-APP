{
  "name": "Task",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "done": {
      "type": "boolean",
      "default": false
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "string",
      "enum": [
        "ai",
        "manual"
      ],
      "default": "manual"
    }
  },
  "required": [
    "gathering_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.member_user_ids": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "$or": [
        {
          "data.member_user_ids": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}