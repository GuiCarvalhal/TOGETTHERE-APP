{
  "properties": {
    "role": {
      "type": "string",
      "description": "The role of the user in the app",
      "enum": [
        "admin",
        "user"
      ]
    },
    "display_name": {
      "type": "string",
      "description": "User-editable display name \u2014 the global profile name. Falls back to the built-in full_name when unset. Set via updateMe (no gathering required) so the profile name is editable universally, independent of any gathering membership."
    },
    "home_city": {
      "type": "string",
      "description": "Home city \u2014 display string for the user's home. Legacy free-text values are shown as-is; a new Google Places selection overwrites this with the resolved formatted address."
    },
    "home_place": {
      "type": "object",
      "description": "Structured Google Place for the user's home, resolved at entry time via autocomplete so future features (distance, local suggestions, travel logistics) have real coordinates. Set ONLY on an explicit new selection; legacy free-text home_city values have no home_place and display as-is. { place_id, lat, lng, country }",
      "properties": {
        "place_id": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "home_currency": {
      "type": "string",
      "description": "Home currency (ISO 4217) \u2014 global profile field, used by the Agent for live conversion"
    },
    "bio": {
      "type": "string",
      "description": "Short intro / bio \u2014 global profile field"
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Interests & preferences tags \u2014 global, helps the Agent tailor recommendations"
    },
    "dietary_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Dietary needs & restrictions (e.g. vegetarian, gluten-free, nut allergy) \u2014 universal profile field, consumed by the Agent"
    },
    "photo": {
      "type": "string",
      "description": "Avatar photo URL \u2014 global profile field"
    }
  },
  "required": [
    "role"
  ],
  "name": "User",
  "type": "object"
}