{
  "name": "Expense",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string"
    },
    "payer_member_id": {
      "type": "string"
    },
    "payer_user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "description": "Original entered amount in the payment currency (canonical). Never round-tripped to USD at save."
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Payment currency (the currency actually used to pay). Canonical, immutable per transaction."
    },
    "display_amount": {
      "type": "number",
      "description": "Snapshot of the amount converted to display_currency, captured ONCE at save time using the live rate then, so an old expense renders deterministically forever (no later live-rate drift). null/absent on historical rows created before this field existed \u2014 those fall back to live conversion. When payment currency === display_currency this equals amount (identity)."
    },
    "display_currency": {
      "type": "string",
      "description": "The display currency display_amount was converted to at save time (the creator's current base currency). Used with display_amount to render the snapshot; ignored when display_amount is null."
    },
    "split_method": {
      "type": "string",
      "enum": [
        "equal",
        "custom",
        "by_share"
      ],
      "default": "equal"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "lodging",
        "transport",
        "activities",
        "other"
      ],
      "default": "other"
    },
    "receipt": {
      "type": "string"
    },
    "settled": {
      "type": "boolean",
      "default": false
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "gathering_id",
    "payer_member_id",
    "title",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_user_ids": "{{user.id}}"
        },
        {
          "data.participant_user_ids": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.payer_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.payer_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}