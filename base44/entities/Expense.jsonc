{
  "name": "Expense",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string"
    },
    "payer_member_id": {
      "type": "string"
    },
    "payer_user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "title": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "split_method": {
      "type": "string",
      "enum": [
        "equal",
        "custom",
        "by_share"
      ],
      "default": "equal"
    },
    "category": {
      "type": "string",
      "enum": [
        "food",
        "lodging",
        "transport",
        "activities",
        "other"
      ],
      "default": "other"
    },
    "receipt": {
      "type": "string"
    },
    "settled": {
      "type": "boolean",
      "default": false
    },
    "date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "gathering_id",
    "payer_member_id",
    "title",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.payer_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.payer_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}