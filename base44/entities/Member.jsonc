{
  "name": "Member",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin",
        "member",
        "viewer"
      ],
      "default": "member"
    },
    "photo": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "home_city": {
      "type": "string"
    },
    "dietary_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "interests": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "budget_level": {
      "type": "string",
      "enum": [
        "budget",
        "moderate",
        "premium"
      ],
      "default": "moderate"
    },
    "arrival_date": {
      "type": "string",
      "format": "date"
    },
    "departure_date": {
      "type": "string",
      "format": "date"
    },
    "contact_info": {
      "type": "string"
    },
    "private_notes": {
      "type": "string"
    },
    "relationships": {
      "type": "object"
    },
    "owner_user_id": {
      "type": "string"
    },
    "notify_master": {
      "type": "boolean",
      "default": true
    },
    "notify_journey": {
      "type": "boolean",
      "default": true
    },
    "notify_expenses": {
      "type": "boolean",
      "default": true
    },
    "notify_members": {
      "type": "boolean",
      "default": true
    },
    "notify_reminders": {
      "type": "boolean",
      "default": true
    },
    "notify_ai": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "gathering_id",
    "user_id",
    "role"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}