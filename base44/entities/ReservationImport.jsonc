{
  "name": "ReservationImport",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "auto_created",
        "manual_created",
        "duplicate",
        "discarded",
        "ignored",
        "failed"
      ],
      "default": "pending",
      "description": "pending = needs the user's decision; ignored = the classifier was not confident enough (see ignored_reason) and nothing was created. ignored rows are kept so the same source message is never re-processed."
    },
    "segment_index": {
      "type": "number",
      "description": "0-based position of this booking inside its source message. One message can hold several bookings (a round trip, a flight plus a hotel), and each one is its own import row."
    },
    "segment_count": {
      "type": "number",
      "description": "How many bookings were detected in the source message, so the UI can say '1 of 3'."
    },
    "source_message_id": {
      "type": "string"
    },
    "source_subject": {
      "type": "string"
    },
    "source_sender": {
      "type": "string"
    },
    "source_recipient": {
      "type": "string"
    },
    "source_received_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_excerpt": {
      "type": "string"
    },
    "target_user_id": {
      "type": "string"
    },
    "target_user_email": {
      "type": "string"
    },
    "target_user_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Read-ACL keys for the owner of this import. Includes canonical user id and/or normalized email to support pre-heal memberships."
    },
    "suggested_gathering_id": {
      "type": "string"
    },
    "candidate_gathering_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "auto_match_score": {
      "type": "number"
    },
    "auto_match_reason": {
      "type": "string"
    },
    "extracted_draft": {
      "type": "object",
      "description": "The standard-form draft for THIS segment. Its attachments array carries the full source email (private storage uri)."
    },
    "classification_type": {
      "type": "string",
      "description": "Item type chosen by the deterministic classifier: flight, hotel, train, car, activity or other."
    },
    "classification_confidence": {
      "type": "number",
      "description": "0-1 confidence from the rule classifier. >= RESERVATION_CONFIDENCE_POLICY.AUTO_CREATE_MIN may auto-create; >= PENDING_MIN queues a pending suggestion; below it nothing is created."
    },
    "classification_signals": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Signal CODES that produced the classification (e.g. checkin_checkout, pnr). Codes only \u2014 never message content \u2014 so this is safe to log or display."
    },
    "classification_reason": {
      "type": "string",
      "description": "Compact internal summary, e.g. 'hotel: checkin_checkout, hotel_terms'. Debug aid, not user copy."
    },
    "classification_source": {
      "type": "string",
      "enum": [
        "rules",
        "ai",
        "none"
      ],
      "description": "Which classifier produced the draft. 'ai' appears when the model split the message into several segments or the optional AI fallback ran."
    },
    "ignored_reason": {
      "type": "string",
      "description": "Reason code when nothing was created: low_confidence, denied_promotional, denied_account_security, denied_non_travel_receipt."
    },
    "pending_reason": {
      "type": "string",
      "description": "Comma-separated reason codes explaining why this pending import cannot be filed yet because it misses the standard item form's minimum data: title, start_datetime, flight_number, flight_origin, flight_destination. Cleared once the item is created."
    },
    "created_item_id": {
      "type": "string"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_user_id": {
      "type": "string"
    },
    "error": {
      "type": "string"
    }
  },
  "required": [
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.target_user_keys": "{{user.id}}"
        },
        {
          "data.target_user_keys": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}