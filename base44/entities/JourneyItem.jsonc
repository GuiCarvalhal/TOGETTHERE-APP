{
  "name": "JourneyItem",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attendee_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_info": {
      "type": "object"
    },
    "type": {
      "type": "string",
      "enum": [
        "flight",
        "car",
        "train",
        "hotel",
        "activity",
        "cruise",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "location_from": {
      "type": "string"
    },
    "location_to": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "confirmation_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "place_photo": {
      "type": "string",
      "description": "Cached public URL of a small Google Places photo for the segment's primary place, resolved once and persisted so cards never re-fetch."
    },
    "reminder_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "place": {
      "type": "object",
      "description": "Resolved Google Place for STAY/ACTIVITY items (single place). Resolved at entry time via autocomplete so the card never re-geocodes at render. { place_id, name, address, lat, lng, country, tz }",
      "properties": {
        "place_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "country": {
          "type": "string"
        },
        "tz": {
          "type": "string"
        }
      }
    },
    "from_place": {
      "type": "object",
      "description": "Resolved Google Place for the ORIGIN of FLIGHT/RIDE/TRAIN/CRUISE items. Same shape as `place`.",
      "properties": {
        "place_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "country": {
          "type": "string"
        },
        "tz": {
          "type": "string"
        }
      }
    },
    "to_place": {
      "type": "object",
      "description": "Resolved Google Place for the DESTINATION of FLIGHT/RIDE/TRAIN/CRUISE items. Same shape as `place`.",
      "properties": {
        "place_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "country": {
          "type": "string"
        },
        "tz": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "gathering_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}