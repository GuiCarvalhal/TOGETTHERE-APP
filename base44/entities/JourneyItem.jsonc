{
  "name": "JourneyItem",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "type": {
      "type": "string",
      "enum": [
        "flight",
        "car",
        "train",
        "hotel",
        "activity",
        "cruise",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "location_from": {
      "type": "string"
    },
    "location_to": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "confirmation_number": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "gathering_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}