{
  "name": "JourneyItem",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "member_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attendee_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "member_info": {
      "type": "object"
    },
    "type": {
      "type": "string",
      "enum": [
        "flight",
        "car",
        "train",
        "hotel",
        "activity",
        "cruise",
        "main_event",
        "other"
      ]
    },
    "title": {
      "type": "string"
    },
    "start_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "end_datetime": {
      "type": "string",
      "format": "date-time"
    },
    "location_from": {
      "type": "string"
    },
    "location_to": {
      "type": "string"
    },
    "location_name": {
      "type": "string"
    },
    "confirmation_number": {
      "type": "string",
      "description": "Flight number for flight segments (e.g. BA208), auto-filled from the flight API. Used by the card meta and live flight-status lookup."
    },
    "booking_reference": {
      "type": "string",
      "description": "Optional airline booking reference / PNR for flight segments. User-entered; not used for rendering."
    },
    "airline": {
      "type": "string",
      "description": "Operating airline name for flight segments (e.g. 'American Airlines'), captured from the flight search result at save time so flight cards render the carrier without parsing the title. Absent on legacy rows; fall back to the title."
    },
    "notes": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "place_photo": {
      "type": "string",
      "description": "Cached public URL of a small Google Places photo for the segment's primary place, resolved once and persisted so cards never re-fetch."
    },
    "reminder_sent_at": {
      "type": "string",
      "format": "date-time"
    },
    "place": {
      "type": "object",
      "description": "Resolved Google Place for STAY/ACTIVITY/MAIN_EVENT items (single place). Resolved at entry time via autocomplete so the card never re-geocodes at render. { place_id, name, address, lat, lng, country, tz, iata, city }",
      "properties": {
        "place_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "country": {
          "type": "string"
        },
        "city": {
          "type": "string",
          "description": "City/locality from Google address_components (locality/postal_town/administrative fallback). Absent on legacy rows."
        },
        "tz": {
          "type": "string"
        },
        "iata": {
          "type": "string",
          "description": "IATA airport code when this place is an airport (flight segments)."
        }
      }
    },
    "from_place": {
      "type": "object",
      "description": "Resolved Google Place for the ORIGIN of FLIGHT/RIDE/TRAIN/CRUISE items. Same shape as `place`.",
      "properties": {
        "place_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "country": {
          "type": "string"
        },
        "country_alpha3": {
          "type": "string",
          "description": "ISO 3166-1 alpha-3 country code (e.g. 'USA', 'ITA') for the origin, derived from the alpha-2 country code. Absent on legacy rows; the card falls back to a static alpha-2->alpha-3 conversion."
        },
        "city": {
          "type": "string",
          "description": "Origin city/locality from Google address_components. Absent on legacy rows."
        },
        "tz": {
          "type": "string"
        },
        "iata": {
          "type": "string",
          "description": "IATA airport code for the origin airport (flight segments)."
        }
      }
    },
    "to_place": {
      "type": "object",
      "description": "Resolved Google Place for the DESTINATION of FLIGHT/RIDE/TRAIN/CRUISE items. Same shape as `place`.",
      "properties": {
        "place_id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "country": {
          "type": "string"
        },
        "country_alpha3": {
          "type": "string",
          "description": "ISO 3166-1 alpha-3 country code (e.g. 'USA', 'ITA') for the destination, derived from the alpha-2 country code. Absent on legacy rows; the card falls back to a static alpha-2->alpha-3 conversion."
        },
        "city": {
          "type": "string",
          "description": "Destination city/locality from Google address_components. Absent on legacy rows."
        },
        "tz": {
          "type": "string"
        },
        "iata": {
          "type": "string",
          "description": "IATA airport code for the destination airport (flight segments)."
        }
      }
    }
  },
  "required": [
    "gathering_id",
    "type",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_user_ids": "{{user.id}}"
        },
        {
          "data.member_user_ids": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}