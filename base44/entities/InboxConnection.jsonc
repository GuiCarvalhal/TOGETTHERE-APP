{
  "name": "InboxConnection",
  "type": "object",
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "gmail",
        "outlook",
        "icloud",
        "yahoo"
      ],
      "description": "Mailbox provider this connection reads from. gmail/outlook use OAuth tokens; icloud/yahoo use IMAP with an app password."
    },
    "status": {
      "type": "string",
      "enum": [
        "connected",
        "attention",
        "disconnected"
      ],
      "default": "connected",
      "description": "connected = syncing normally; attention = token/permission problem the user must fix; disconnected = user turned it off."
    },
    "target_user_id": {
      "type": "string",
      "description": "App user whose reservations are imported from this mailbox."
    },
    "target_user_email": {
      "type": "string"
    },
    "target_user_keys": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Read-ACL keys (user id and/or normalized email) stamped onto imports."
    },
    "account_key": {
      "type": "string",
      "description": "Stable per-account identifier: '<provider>:<lowercased mailbox address>'. Lets one user hold several mailboxes of the same provider, and makes reconnecting the SAME mailbox update its existing row instead of adding a duplicate. Legacy rows without it are healed on the next connect/sync."
    },
    "display_label": {
      "type": "string",
      "description": "User-visible label for this mailbox. Defaults to provider_account_email."
    },
    "provider_account_email": {
      "type": "string",
      "description": "Address of the connected mailbox, shown in the UI."
    },
    "access_token": {
      "type": "string"
    },
    "refresh_token": {
      "type": "string"
    },
    "access_token_expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "credential_secret": {
      "type": "string",
      "description": "AES-GCM encrypted app password for IMAP providers (icloud/yahoo), stored as v1:<iv>:<ciphertext>. Never returned to the client; cleared on disconnect."
    },
    "sync_cursor": {
      "type": "string",
      "description": "ISO timestamp of the newest message already scanned; subsequent syncs only look past it."
    },
    "uid_cursor": {
      "type": "number",
      "description": "IMAP only: highest INBOX UID already scanned. Lets iCloud/Yahoo sync fetch strictly newer messages instead of re-reading a time window."
    },
    "sync_interval_minutes": {
      "type": "number",
      "enum": [
        60,
        360,
        1440,
        10080
      ],
      "default": 60,
      "description": "How often this mailbox may be synced in the background: 1h, 6h, 24h or Weekly. Manual 'Sync now' bypasses it. Absent or legacy values (5/15/30) are normalized to the 1h default."
    },
    "next_sync_at": {
      "type": "string",
      "format": "date-time",
      "description": "Earliest background sync instant, persisted as last_attempt_at + sync_interval_minutes for display. The authoritative check always recomputes from last_attempt_at."
    },
    "last_attempt_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a sync was last ATTEMPTED, successful or not. Cadence is measured from here so a failing mailbox is not retried on every Home load."
    },
    "sync_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Lease marker set when a sync starts and cleared when it ends, so overlapping background jobs skip a mailbox already being synced."
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_sync_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_error": {
      "type": "string"
    },
    "disabled_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "provider",
    "target_user_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}