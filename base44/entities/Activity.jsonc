{
  "name": "Activity",
  "type": "object",
  "properties": {
    "gathering_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "expense_added",
        "journey_added",
        "join_requested",
        "join_approved",
        "relationship_close",
        "member_added",
        "gathering_updated"
      ]
    },
    "actor_user_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "meta": {
      "type": "object"
    },
    "owner_user_id": {
      "type": "string"
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "gathering_id",
    "type",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_user_ids": "{{user.id}}"
        },
        {
          "data.participant_user_ids": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}