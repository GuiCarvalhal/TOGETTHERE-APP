{
  "name": "ExpenseSplit",
  "type": "object",
  "properties": {
    "expense_id": {
      "type": "string"
    },
    "gathering_id": {
      "type": "string"
    },
    "member_id": {
      "type": "string"
    },
    "share": {
      "type": "number"
    },
    "amount": {
      "type": "number"
    },
    "payer_user_id": {
      "type": "string"
    },
    "owner_user_id": {
      "type": "string"
    },
    "participant_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "expense_id",
    "member_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participant_user_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.payer_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.payer_user_id": "{{user.id}}"
        },
        {
          "data.owner_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}